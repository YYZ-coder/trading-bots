# 复制成 .env 再填写：cp .env.example .env
# .env 已在 .gitignore 里，不会被提交。千万不要把私钥发给任何人。

# ===== Hyperliquid =====
# 签名用的私钥。强烈推荐用 API 钱包（在 app.hyperliquid.xyz/API 创建）：只能交易、不能提币。
HL_PRIVATE_KEY=
# 主账户地址。用 API 钱包时必填（余额和持仓在主账户上）；直接用主钱包私钥时留空。
HL_ACCOUNT_ADDRESS=

# ===== OKX =====
# 模拟盘和实盘的 API Key 是分开的：-mode live 默认用模拟盘，需要填模拟盘 Key。
# 建议：用子账户的 Key，只开"交易"权限，不开"提现"，并绑定 IP 白名单。
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
# 可选：OKX 分站域名，默认 https://www.okx.com
OKX_BASE_URL=
